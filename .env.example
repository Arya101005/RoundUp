# Supabase project (frontend-safe values only; NEVER put the service role key here)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Public app URL used for share links and CORS (no trailing slash)
VITE_APP_URL=http://localhost:5173

# Server-side secrets (Edge Function secrets, set with `supabase secrets set`, never bundled)
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.example

# AI provider (optional; app works with AI disabled)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_PROVIDER=
